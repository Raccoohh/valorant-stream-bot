# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/valorant_stream
REDIS_URL=redis://localhost:6379/0

# ---- Twitch ----
# OAuth token for the BOT account (get one at https://twitchtokengenerator.com/)
TWITCH_TOKEN=oauth:your_bot_oauth_token_here
TWITCH_CHANNEL=raccoohh
TWITCH_PREFIX=!

# App credentials from https://dev.twitch.tv/console — used by the stream
# watcher to auto start/stop sessions when you go live (no tunnels needed).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_INTERVAL_SECONDS=60

# ---- HenrikDev Valorant API ----
# v4 REQUIRES an API key — get a free one at https://docs.henrikdev.xyz/
HENRIK_API_KEY=
VALORANT_NAME=raccoohh
VALORANT_TAG=EUW
VALORANT_REGION=eu
VALORANT_PLATFORM=pc
# Optional queue filter (competitive, unrated, swiftplay...). Empty = all modes.
HENRIK_MODE=

# ---- Poller ----
POLL_INTERVAL_SECONDS=60

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Dev tooling ----
# Enables POST /dev/simulate/* (fake ace/clutch/match events for testing
# the overlay and chat alerts). Set to false for any real deployment.
ENABLE_DEV_ROUTES=true
